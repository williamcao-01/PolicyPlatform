COMPOSE_PROJECT_NAME=policy-assistant
FRONTEND_HTTP_PORT=8080
FRONTEND_IMAGE=policy-assistant-frontend:local
BACKEND_IMAGE=policy-assistant-backend:local

APP_NAME=policy-assistant
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api
ALLOWED_ORIGINS=https://example.com

POSTGRES_DB=policy_assistant
POSTGRES_USER=policy_assistant
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

AUTH_TOKEN_SECRET=replace-with-random-token-secret
AUTH_ACCESS_TOKEN_SECONDS=3600
AUTH_REFRESH_TOKEN_SECONDS=604800
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-bootstrap-admin-password
AUTH_ENFORCE_LEGACY_RBAC=true

MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-strong-minio-secret-key
MINIO_BUCKET=policy-assistant
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=policy-assistant
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-minio-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-strong-minio-secret-key

QUEUE_PROVIDER=rocketmq
QUEUE_URL=rocketmq-namesrv:9876
QUEUE_DEFAULT_TOPIC=policy-assistant.jobs
QUEUE_DEAD_LETTER_TOPIC=policy-assistant.dead-letter

LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
USE_REAL_LLM=false
DEMO_DB_PATH=backend/demo.db
POLICY_SOURCE_DIR=backend/uploads/policy_sources
KNOWLEDGE_BASE_ENABLED=false
KNOWLEDGE_API_URL=http://127.0.0.1:8765
KNOWLEDGE_API_KEY=
