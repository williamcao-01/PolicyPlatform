{
  "id": "skill_policy_process_check",
  "name": "制度与流程校验",
  "description": "检查制度条款与 BPMN 审批流程节点是否一致。",
  "required_inputs": [
    {
      "name": "policy_ids",
      "label": "制度文件",
      "type": "policy[]",
      "min": 1
    },
    {
      "name": "process_ids",
      "label": "BPMN 流程",
      "type": "process[]",
      "min": 1,
      "max": 1
    }
  ],
  "output_types": ["finding", "bpmn_annotation", "evidence", "suggestion", "professional_reference", "question"],
  "can_update_assets": true,
  "allowed_finding_types": ["missing_process_node", "extra_process_node", "authority_mismatch", "policy_conflict"],
  "evidence_policy": {
    "min_evidence": 1,
    "allowed_source_types": ["policy_clause", "bpmn_node"]
  }
}
